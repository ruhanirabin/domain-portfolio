# ============================================================
# domain-portfolio.env
#
# Unified credentials for domain-portfolio.sh
#
# Usage:
#   Copy to .env beside the script and fill in your values.
#   chmod 600 .env
#   Never commit this file to Git.
# ============================================================

# --- Cloudflare ---
# Create at https://dash.cloudflare.com/profile/api-tokens
# Permissions needed:
#   Zone:Zone          — Read
#   Account:Registrar  — Read
CLOUDFLARE_ACCOUNT_ID="replace-with-32-character-account-id"
CLOUDFLARE_API_TOKEN="replace-with-api-token"

# --- Porkbun ---
# Create at https://porkbun.com/account/api
PORKBUN_API_KEY="replace-with-porkbun-api-key"
PORKBUN_SECRET_API_KEY="replace-with-porkbun-secret-api-key"
